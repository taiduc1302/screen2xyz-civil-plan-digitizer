+class EnclosingPairTests(unittest.TestCase):
+    """Two fragments can share both ends and still be different line.
+
+    Endpoint-only dedupe dropped one of them and took its length with it,
+    with `duplicates_removed` as the only trace and no finding raised.
+    """
+
+    def test_a_shape_drawn_as_two_polylines_keeps_both_sides(self):
+        # a median island, a pavement patch, a curb return closed by its own
+        # tie line: the two sides meet at both ends and enclose the shape
+        top = [(0.0, 0.0), (10.0, 6.0), (30.0, 6.0), (40.0, 0.0)]
+        bottom = [(0.0, 0.0), (10.0, -6.0), (30.0, -6.0), (40.0, 0.0)]
+        drawn = sum(
+            math.dist(a, b) for f in (top, bottom) for a, b in zip(f, f[1:])
+        )
+        r = chain_fragments([top, bottom])
+        self.assertEqual(r["duplicates_removed"], 0)
+        self.assertEqual(r["fragments_used"], 2)
+        self.assertAlmostEqual(r["total_length"], drawn, places=6)
+
+    def test_an_arc_and_its_chord_are_not_the_same_line(self):
+        arc = [(0.0, 0.0), (5.0, 4.0), (10.0, 5.0), (15.0, 4.0), (20.0, 0.0)]
+        chord = [(0.0, 0.0), (20.0, 0.0)]
+        r = chain_fragments([arc, chord])
+        self.assertEqual(r["duplicates_removed"], 0)
+        self.assertEqual(r["fragments_used"], 2)
+
+    def test_a_reversed_plotted_copy_is_still_a_duplicate(self):
+        # the path check must not cost us the dedupe the method relies on
+        arc = [(0.0, 0.0), (5.0, 4.0), (10.0, 5.0), (15.0, 4.0), (20.0, 0.0)]
+        r = chain_fragments([arc, list(reversed(arc))])
+        self.assertEqual(r["duplicates_removed"], 1)
+        self.assertEqual(r["fragments_used"], 1)
+
+
+class GapStatisticTests(unittest.TestCase):
+    def test_a_full_layer_still_reads_its_tolerance_from_the_linetype(self):
+        # the guard below must not disturb the case that works: ten dashes
+        # give eighteen measured gaps, well over MIN_GAP_SAMPLE, so the
+        # tolerance still comes from the percentile as before
+        frags = dashes(0, 0, dash=10.0, gap=5.0, n=10)
+        stats = nearest_gap_stats(frags)
+        self.assertGreaterEqual(stats["count"], MIN_GAP_SAMPLE)
+        self.assertAlmostEqual(chain_fragments(frags)["gap_tol"], 7.5, places=6)
+
+    def test_a_small_layer_does_not_read_its_tolerance_from_its_largest_gap(self):
+        # four dashes plus one separate line 254 pt away: eight measured
+        # gaps, too few for a 90th percentile to mean anything. Reading the
+        # max would weld the two into one chain and count the blank paper
+        # between them as line.
+        frags = [[(x, 0.0), (x + 10.0, 0.0)] for x in (0.0, 12.0, 24.0, 36.0)]
+        frags.append([(300.0, 0.0), (310.0, 0.0)])
+        drawn = sum(
+            math.dist(a, b) for f in frags for a, b in zip(f, f[1:])
+        )
+        r = chain_fragments(frags)
+        self.assertLess(r["gap_tol"], 254.0)
+        self.assertEqual(len(r["chains"]), 2)
+        self.assertLess(r["total_length"], drawn + 20.0)
+
