+def _point_at(pts: Sequence[Point], t: float) -> Point:
+    """The point at fraction ``t`` of a fragment's own length."""
+
+    total = _length(pts)
+    if total <= 0:
+        return (float(pts[0][0]), float(pts[0][1]))
+    target, run = t * total, 0.0
+    for a, b in zip(pts, pts[1:]):
+        step = math.dist(a, b)
+        if run + step >= target:
+            f = 0.0 if step <= 0 else (target - run) / step
+            return (a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f)
+        run += step
+    return (float(pts[-1][0]), float(pts[-1][1]))
+
+
+def _paths_agree(a: Sequence[Point], b: Sequence[Point], tol: float) -> bool:
+    """Do two fragments that share their ends also share the way between?
+
+    Endpoints alone cannot tell a plotted copy from the far side of an
+    island, the other half of a circle, or an arc from its chord - each of
+    those meets at both ends and encloses the drawing in between, and
+    dropping one of them silently removes real line. A plotted copy matches
+    everywhere, so comparing the length and three interior samples separates
+    the two cases and costs nothing.
+    """
+
+    if abs(_length(a) - _length(b)) > tol:
+        return False
+    return all(
+        math.dist(_point_at(a, t), _point_at(b, t)) <= tol
+        for t in (0.25, 0.5, 0.75)
+    )
+
