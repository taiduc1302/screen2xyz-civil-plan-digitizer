@@ -0,0 +1,110 @@
+"""The page frame the toolkit declares must be the one it draws in.
+
+`page.rect` in PyMuPDF is the CropBox and every renderer that matters here
+rasterises that box, but a PDF annotation's `/Rect` is in MediaBox-anchored
+user space. Where a sheet is cropped - a re-issue, an addendum, a re-print -
+the two disagree by the CropBox origin. It is a pure translation, so lengths
+and areas stay right and nothing looks wrong; only the placement moves, and
+the session's own bounds check cannot catch it because a shifted polygon is
+smaller than the frame it is compared against.
+"""
+
+from __future__ import annotations
+
+import unittest
+
+from screen2xyz_civil.pdf import inspect_pdf
+
+from .helpers_civil import fresh_dir
+
+MEDIA = (0.0, 0.0, 612.0, 792.0)
+CROP = (20.0, 30.0, 592.0, 762.0)
+
+
+def write_pdf(path, media, crop=None):
+    """A one-page PDF with a line at user-space (100,100)-(100,200)."""
+
+    content = b"1 w 0 G\n100 100 m 100 200 l S\n"
+    crop_entry = ("/CropBox [%g %g %g %g]" % crop) if crop else ""
+    objects = [
+        b"<< /Type /Catalog /Pages 2 0 R >>",
+        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+        (
+            "<< /Type /Page /Parent 2 0 R /MediaBox [%g %g %g %g] %s "
+            "/Contents 4 0 R /Resources << >> >>" % (media + (crop_entry,))
+        ).encode(),
+        b"<< /Length %d >>\nstream\n" % len(content) + content + b"endstream",
+    ]
+    out = bytearray(b"%PDF-1.7\n")
+    offsets = []
+    for number, body in enumerate(objects, start=1):
+        offsets.append(len(out))
+        out += b"%d 0 obj\n" % number + body + b"\nendobj\n"
+    startxref = len(out)
+    out += b"xref\n0 %d\n" % (len(objects) + 1) + b"0000000000 65535 f \n"
+    for offset in offsets:
+        out += b"%010d 00000 n \n" % offset
+    out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (
+        len(objects) + 1,
+        startxref,
+    )
+    path.write_bytes(bytes(out))
+    return path
+
+
+class DeclaredPageSizeTests(unittest.TestCase):
+    def test_an_uncropped_page_reports_the_mediabox_unchanged(self):
+        pdf = write_pdf(fresh_dir() / "plain.pdf", MEDIA)
+        page = inspect_pdf(pdf).pages[0]
+        self.assertAlmostEqual(page.width_points, 612.0, places=6)
+        self.assertAlmostEqual(page.height_points, 792.0, places=6)
+
+    def test_a_cropped_page_reports_the_rendered_box_not_the_mediabox(self):
+        pdf = write_pdf(fresh_dir() / "cropped.pdf", MEDIA, CROP)
+        page = inspect_pdf(pdf).pages[0]
+        self.assertAlmostEqual(page.width_points, 572.0, places=6)
+        self.assertAlmostEqual(page.height_points, 732.0, places=6)
+
+
+class RenderFrameTests(unittest.TestCase):
+    def setUp(self):
+        try:
+            import pymupdf  # noqa: F401,PLC0415
+        except ImportError:  # pragma: no cover - optional dependency
+            self.skipTest("pymupdf is not installed")
+
+    def test_the_fill_renderer_refuses_a_page_whose_cropbox_is_not_its_mediabox(self):
+        from screen2xyz_civil.fill_layers import FillLayerError, render_viewport
+        from screen2xyz_civil.plan_layers import Viewport
+
+        pdf = write_pdf(fresh_dir() / "cropped.pdf", MEDIA, CROP)
+        viewport = Viewport(
+            name="v", x0=50.0, y0=50.0, x1=300.0, y1=300.0,
+            metres_per_point_x=0.1, metres_per_point_y=0.1,
+        )
+        with self.assertRaises(FillLayerError) as caught:
+            render_viewport(pdf, 0, viewport, dpi=90)
+        self.assertIn("CropBox", str(caught.exception))
+
+    def test_the_render_frame_origin_comes_from_the_pixmap_not_the_request(self):
+        # get_pixmap snaps the clip outward to whole pixels; reading the
+        # origin back off the request put every traced boundary up to one
+        # pixel out, always in the same direction
+        from screen2xyz_civil.fill_layers import render_viewport
+        from screen2xyz_civil.plan_layers import Viewport
+
+        pdf = write_pdf(fresh_dir() / "plain.pdf", MEDIA)
+        viewport = Viewport(
+            name="v", x0=100.3, y0=200.7, x1=300.3, y1=400.7,
+            metres_per_point_x=0.1, metres_per_point_y=0.1,
+        )
+        _, frame = render_viewport(pdf, 0, viewport, dpi=90)
+        zoom = 90 / 72.0
+        self.assertAlmostEqual(frame.display_x0 * zoom % 1.0, 0.0, places=9)
+        self.assertAlmostEqual(frame.display_y0 * zoom % 1.0, 0.0, places=9)
+        self.assertLessEqual(frame.display_x0, 100.3)
+        self.assertLessEqual(frame.display_y0, 200.7)
+
