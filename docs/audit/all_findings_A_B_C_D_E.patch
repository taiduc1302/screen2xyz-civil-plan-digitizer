+def _effective_page_size(page: Any) -> tuple[float, float]:
+    """The rendered box: the CropBox clipped to the MediaBox, else the MediaBox.
+
+    Every renderer that matters here - PDFium, Revu, PyMuPDF - rasterises the
+    CropBox, and PyMuPDF's `page.rect` is that box. Reading the MediaBox
+    instead makes the declared page size disagree with the frame the geometry
+    is actually measured and drawn in whenever a sheet is cropped, which a
+    re-issue or an addendum can do at any time; the bounds check downstream
+    then passes geometry that is out of frame, because a shifted polygon is
+    smaller than the box it is compared against.
+    """
+
+    try:
+        media = [float(value) for value in page.mediabox]
+        crop = [float(value) for value in page.cropbox]
+    except Exception:
+        return float(page.mediabox.width), float(page.mediabox.height)
+    left = max(min(media[0], media[2]), min(crop[0], crop[2]))
+    bottom = max(min(media[1], media[3]), min(crop[1], crop[3]))
+    right = min(max(media[0], media[2]), max(crop[0], crop[2]))
+    top = min(max(media[1], media[3]), max(crop[1], crop[3]))
+    width, height = right - left, top - bottom
+    if width <= 0 or height <= 0:
+        return float(page.mediabox.width), float(page.mediabox.height)
+    return width, height
+
+
