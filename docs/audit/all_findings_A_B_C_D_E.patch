+class CoverageGateTests(unittest.TestCase):
+    """Coverage has to fail QA, not merely appear beside it.
+
+    The gateway attached `scope` to the QA result and nothing consulted it,
+    so a pass with whole rules never searched came back with `issues: []` -
+    a clean bill for a half-finished sheet.
+    """
+
+    make_session = ScopeLedgerTests.make_session
+
+    def test_qa_refuses_a_sheet_with_rules_that_were_never_searched(self):
+        qa = self.make_session().qa_summary()
+        codes = [issue["code"] for issue in qa["issues"]]
+        self.assertIn("SCOPE_NOT_SEARCHED", codes)
+        self.assertGreaterEqual(qa["issue_counts"]["ERROR"], 1)
+        self.assertGreaterEqual(qa["blocked"], 1)
+
+    def test_qa_stops_objecting_once_every_rule_is_accounted(self):
+        session = self.make_session()
+        for rule_id in RULES:
+            set_scope_status(
+                session,
+                rule_id=rule_id,
+                status=WITHHELD,
+                detail=f"Synthetic coverage accounting for {rule_id}.",
+                now=LATER,
+            )
+        qa = session.qa_summary()
+        self.assertNotIn(
+            "SCOPE_NOT_SEARCHED", [issue["code"] for issue in qa["issues"]]
+        )
+        self.assertTrue(qa["scope"]["ready_for_coverage_review"])
+
+
 if __name__ == "__main__":
